# DataSteward 环境配置模板
# 用法：cp .env.example .env，按需填写。本文件只放占位符，绝不提交真实密钥（.env 已被 gitignore）。

# ===================== LLM（智能体必需，二选一）=====================
# 方案 A（默认推荐，零 GPU）：任意 OpenAI 兼容云 API（OpenAI / DeepSeek / Moonshot / 通义…）
#   例：DeepSeek → DM_LLM_BASE_URL=https://api.deepseek.com/v1  DM_LLM_MODEL=deepseek-chat
DM_LLM_BASE_URL=https://api.openai.com/v1
DM_LLM_API_KEY=
DM_LLM_MODEL=gpt-4o-mini

# 方案 B（全本地，数据不出域）：docker compose --profile ollama up -d 后，改用下面三行：
#   （模型需支持 tool-calling；qwen3:8b ~5GB，需相应内存/显存）
# DM_LLM_BASE_URL=http://ollama:11434/v1
# DM_LLM_API_KEY=sk-local
# DM_LLM_MODEL=qwen3:8b
# 若用宿主机自装的 ollama（非 compose 内）：DM_LLM_BASE_URL=http://host.docker.internal:11434/v1

# ===================== 数据面（开发默认值，可不动）=====================
# StarRocks 业务库 / dbt 产出库
DM_WH_DB=dm
DM_DW_SCHEMA=dm_dw
# Postgres 影子源（CDC 源 + pgvector 向量库 + Dagster/检查点库，一身三职）
DM_SRC_PG_USER=dm
DM_SRC_PG_PASSWORD=dm_dev_pass
DM_SRC_PG_DB=dm
# Neo4j 知识图谱
DM_NEO4J_PASSWORD=datasteward-dev

# ===================== 可选 profile =====================
# --profile sim-u8（用友 U8 仿真源，x86 only）
# MSSQL_SA_PASSWORD=SimU8!Passw0rd
# 真实 U8 / SQL Server 源（配好即可 dm-u8 full 批抽）
# DM_SRC_MSSQL_HOST=
# DM_SRC_MSSQL_PORT=1433
# DM_SRC_MSSQL_USER=
# DM_SRC_MSSQL_PASSWORD=
# DM_SRC_MSSQL_DB=

# --profile dingtalk（钉钉 Stream 双向机器人；另需 cp deploy/role_map.yaml.template role_map.yaml）
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=
# 健康告警单向推送（钉钉群自定义机器人 webhook，可独立于上面使用）
# DINGTALK_WEBHOOK=
# DINGTALK_WEBHOOK_SECRET=

# --profile om（OpenMetadata，重型可选件）
# OM_MYSQL_ROOT_PASSWORD=om_dev_root
# OM_MYSQL_PASSWORD=openmetadata_password

# --profile ollama 拉取的模型（默认 qwen3:8b）
# DM_OLLAMA_PULL=qwen3:8b

# ===================== 宿主端口重映射（与本机已有服务冲突时改这里）=====================
# DM_PORT_SR=9030          # StarRocks FE MySQL 协议
# DM_PORT_SR_HTTP=8030     # StarRocks FE HTTP / Stream Load
# DM_PORT_SR_BE=8040       # StarRocks BE HTTP
# DM_PORT_PG=15432         # Postgres
# DM_PORT_FLINK=8081       # Flink Web UI
# DM_PORT_NEO4J_HTTP=7474
# DM_PORT_NEO4J_BOLT=7687
# DM_PORT_APP=8501         # Streamlit 治理台
# DM_PORT_DAGSTER=3070     # Dagster UI
# DM_PORT_OLLAMA=11434
# DM_PORT_MSSQL=11433
# DM_PORT_OM=8585
